{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"declaration": true,
		"declarationMap": false,
		"emitDeclarationOnly": false,
		"rootDir": "src",
		"outDir": "lib",
		"noEmitOnError": true,
		"paths": {
			"@amll-ttml-tool/plugin-api": [
				"../plugin-api/lib/index.d.ts"
			],
			"@amll-ttml-tool/plugin-api/*": [
				"../plugin-api/lib/*"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
